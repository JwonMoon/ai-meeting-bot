# 이 파일을 .env 로 복사한 뒤 값을 채운다:  cp .env.example .env && chmod 600 .env
# .env 는 git에 올라가지 않는다. 토큰을 이 파일(.env.example)에 적지 말 것.
#
# 주의: 지금 쓰는 토큰은 개인 Personal Access Token 이고 시험용이다.
# 팀 운영 전에 봇 전용 계정의 토큰으로 교체해야 한다.

# Confluence (사내 설치형). 주소는 /rest 앞부분까지. 끝에 / 없음.
CONFLUENCE_BASE_URL=https://confluence.example.com/context
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE_KEY=
# 시험 페이지를 만들 상위 페이지의 ID (페이지 주소의 /pages/<숫자>/ 부분)
CONFLUENCE_PARENT_PAGE_ID=

# Jira (사내 설치형). 주소는 /rest 앞부분까지. 끝에 / 없음.
JIRA_BASE_URL=https://jira.example.com/context
JIRA_TOKEN=
JIRA_PROJECT_KEY=
# 이슈 유형 번호. createmeta 로 조회한 값.
JIRA_ISSUE_TYPE_ID=

# Teams Workflows webhook URL. 이 URL을 아는 사람은 누구나 채널에 글을 쓸 수 있다.
TEAMS_WEBHOOK_URL=

# 로컬 LLM (Ollama). Thor 안에서만 접속한다.
OLLAMA_BASE_URL=http://localhost:11434
# `ollama list` 에 나오는 이름 그대로.
OLLAMA_MODEL=
# 모델이 한 번에 읽을 수 있는 분량(토큰). 긴 회의록이 잘리면 늘린다.
OLLAMA_NUM_CTX=16384

# ---- 음성 인식 (src/meetingbot/stt.py 윗부분 설명 참고) ----
# 잘라 낸 wav 한 구간을 글로 바꾸는 명령. {audio} 자리에 wav 경로가 들어간다.
# 지금은 다른 사용자의 컨테이너 안 스크립트를 쓰므로 그 실행 방법을 그대로 적는다. 예:
#   STT_COMMAND=docker exec <컨테이너이름> python3 /work/transcribe.py {audio}
# 봇 전용 컨테이너에 qwen-asr 를 설치했으면 (모델을 한 번만 올려 빠름):
#   STT_COMMAND=docker exec <컨테이너이름> python3 /work/scripts/asr_worker.py --language {language} --max-new-tokens {max_new_tokens} {audios}
STT_COMMAND=
# 컨테이너가 Thor 의 폴더를 다른 이름으로 볼 때 "Thor경로:컨테이너경로". 같으면 비움.
#   예: STT_PATH_MAP=/home/bot/ai-meeting-bot/data:/data
STT_PATH_MAP=
# 언어 강제. 비우면 자동 감지. Qwen3-ASR 은 영어 이름을 받는다 (Korean, English).
STT_LANGUAGE=
# 한 구간에서 모델이 만들 수 있는 토큰 수 상한. 1분 한국어 말은 300 안팎. 글이 끊기면 늘린다.
STT_MAX_NEW_TOKENS=400
# 한 구간 길이(초) 목표. 말 없는 곳에서만 끊으므로 실제는 0.5~1.5배.
STT_CHUNK_SECONDS=60
# 이 소리 크기(dB) 아래가 이 시간(초) 이상 이어지면 "말 없음"으로 보고 모델에 넣지 않는다.
# 조용한 말이 잘려 나가면 STT_SILENCE_DB 를 -50 쪽으로 내린다.
STT_SILENCE_DB=-40
STT_MIN_SILENCE_SECONDS=0.7
# 한 구간이 이 시간(초) 안에 안 끝나면 중단. 음성 길이의 STT_SLOW_FACTOR 배를 넘으면 경고만.
STT_CHUNK_TIMEOUT_SECONDS=600
STT_SLOW_FACTOR=2

# 작업 기록(SQLite)과 녹음·전사·회의록 파일을 두는 폴더. 비우면 저장소 안 data/.
DATA_DIR=
# ffmpeg 와 ffprobe 가 있는 폴더. Thor 의 /usr/bin/ffmpeg 는 mp3 를 못 읽는 빌드라 봇 전용 ffmpeg 를 쓴다.
#   예: FFMPEG_DIR=/home/meetingbot/ffmpeg
# 비우면 PATH 에서 찾는다.
FFMPEG_DIR=

# ---- 공용 GPU 양보 ----
# 음성 인식·요약 시작 전에 nvidia-smi 로 GPU 를 본다. 사용률(%)이 이 값을 넘거나
# 다른 프로세스가 GPU 를 쓰고 있으면 기다린다. 이 시간(분)을 넘기면 작업을 실패로 두고 나중에 재시도.
GPU_BUSY_UTILIZATION=20
GPU_WAIT_MINUTES=30
GPU_POLL_SECONDS=30
