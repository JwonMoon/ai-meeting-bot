# 이 파일을 .env 로 복사한 뒤 값을 채운다:  cp .env.example .env && chmod 600 .env
# .env 는 git에 올라가지 않는다. 토큰을 이 파일(.env.example)에 적지 말 것.
#
# 주의: 지금 쓰는 토큰은 개인 Personal Access Token 이고 시험용이다.
# 팀 운영 전에 봇 전용 계정의 토큰으로 교체해야 한다.

# Confluence (사내 설치형). 주소는 /rest 앞부분까지. 끝에 / 없음.
CONFLUENCE_BASE_URL=https://confluence.example.com/context
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE_KEY=
# 시험 페이지를 만들 상위 페이지의 ID (페이지 주소의 /pages/<숫자>/ 부분)
CONFLUENCE_PARENT_PAGE_ID=

# Jira (사내 설치형). 주소는 /rest 앞부분까지. 끝에 / 없음.
JIRA_BASE_URL=https://jira.example.com/context
JIRA_TOKEN=
JIRA_PROJECT_KEY=
# 이슈 유형 번호. createmeta 로 조회한 값.
JIRA_ISSUE_TYPE_ID=

# Teams Workflows webhook URL. 이 URL을 아는 사람은 누구나 채널에 글을 쓸 수 있다.
TEAMS_WEBHOOK_URL=
